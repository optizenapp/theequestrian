{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "S3WriteVideosAndArticles",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:PutObjectAcl",
        "s3:GetObject",
        "s3:DeleteObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::theequestrian-articles-images",
        "arn:aws:s3:::theequestrian-articles-images/*"
      ]
    },
    {
      "Sid": "SesSendEmail",
      "Effect": "Allow",
      "Action": ["ses:SendEmail", "ses:SendRawEmail"],
      "Resource": "*"
    }
  ]
}
