{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "theequestrian.com.au" }],
      "missing": [{ "type": "header", "key": "x-amz-sns-message-type" }],
      "destination": "https://www.theequestrian.com.au/:path*",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/cron/404-rollup",
      "schedule": "10 2 * * *"
    },
    {
      "path": "/api/cron/gmc-feed",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/ga4-sync",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/email-campaigns",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/auto-weekly-build",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/auto-weekly-release",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/auto-campaign-resend",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/sitemaps",
      "schedule": "15 2 * * *"
    }
  ]
}
