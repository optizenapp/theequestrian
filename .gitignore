# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local

# Shopify exports (may contain sensitive pricing data)
shopify-*.csv
*-export.csv
*-updated.csv

# Vendor shipping rates (business sensitive)
# Note: TEMPLATE files are safe to commit
exports/vendor-shipping-rates.csv
exports/tag-shipping-rates.csv

# Brand audit/rollup intermediates (regenerated by scripts; canonical inputs are tracked)
exports/brand-audit-*.csv
exports/parent-brand-resolve-map-*.csv
exports/parent-brand-rollup-exceptions-*.csv
exports/parent-brand-rollup.handle-prefix-patch.csv
exports/parent-brand-rollup.title-match-patch.csv
exports/parent-brand-rollup.title-match-no-audit.json
exports/parent-brand-rollup.patch.csv
exports/parent-brand-rollup.mapped.xlsx
