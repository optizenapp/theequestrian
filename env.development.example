# ============================================
# DEVELOPMENT ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env.local and fill in your values

# Shopify Configuration
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=your_storefront_access_token
SHOPIFY_ADMIN_ACCESS_TOKEN=your_admin_access_token

# Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Development Database (Neon Dev Branch)
# Create a dev branch in Neon Console: https://console.neon.tech
POSTGRES_URL=postgresql://user:password@dev-branch.neon.tech/neondb?sslmode=require

# SES Email Service (Development)
SES_AWS_ACCESS_KEY_ID=your_ses_aws_access_key_id
SES_AWS_SECRET_ACCESS_KEY=your_ses_aws_secret_access_key
SES_AWS_REGION=ap-southeast-2
SES_AWS_FROM_EMAIL=dev@yourdomain.com
SES_AWS_CONFIGURATION_SET=theequestrian-email

# Admin Authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_password

# Google Merchant Center (OAuth + Feed)
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id
GOOGLE_OAUTH_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_OAUTH_REDIRECT_URI=https://www.theequestrian.com.au/api/admin/gmc/callback
GMC_MERCHANT_ID=your_merchant_center_id
GMC_BASE_URL=http://localhost:3001

# YouTube Publishing (OAuth + token encryption)
YOUTUBE_OAUTH_CLIENT_ID=your_youtube_oauth_client_id
YOUTUBE_OAUTH_CLIENT_SECRET=your_youtube_oauth_client_secret
YOUTUBE_OAUTH_REDIRECT_URI=http://localhost:3000/api/admin/social/youtube/callback
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_OAUTH_REDIRECT_URI=http://localhost:3003/api/admin/social/facebook/callback
FACEBOOK_LOGIN_CONFIG_ID=your_facebook_login_config_id
FACEBOOK_PAGE_ID=optional_page_id_to_force
FACEBOOK_PAGE_NAME=The Equestrian
FACEBOOK_SYSTEM_USER_ACCESS_TOKEN=optional_system_user_token
INSTAGRAM_BUSINESS_ACCOUNT_ID=optional_instagram_business_account_id
SOCIAL_TOKEN_ENC_KEY=64_hex_chars_generated_with_openssl_rand_hex_32
YOUTUBE_COPY_MODEL=gpt-4o-mini

# Google Sheets Customer Sync (for dynamic Ads datasource)
GOOGLE_SHEETS_CUSTOMER_SHEET_ID=your_google_sheet_id
GOOGLE_SHEETS_CUSTOMER_TAB=Customers
GOOGLE_SHEETS_SERVICE_ACCOUNT_EMAIL=your-service-account@project-id.iam.gserviceaccount.com
GOOGLE_SHEETS_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Optional: Newsletter Integration
MOOSEND_API_KEY=your_moosend_api_key

# ============================================
# NOTES
# ============================================
# - Never commit .env.local to git (it's gitignored)
# - Use separate database for dev (create branch in Neon)
# - Keep production and development credentials separate
# - See DEV-ENVIRONMENT-SETUP.md for detailed setup
